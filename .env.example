# Copy to .env — docker compose reads it automatically.
PORT=8080
TZ=Europe/Rome
# Host folder that holds ALL app data (database + photos). Copy it as-is to migrate.
DATA_PATH=./data
# User/group the container runs as; must be able to write DATA_PATH (run `id` to find yours).
PUID=1000
PGID=1000
# AI assistant (Phase 3) — backend only, never sent to the browser.
ANTHROPIC_API_KEY=
AI_MODEL=
