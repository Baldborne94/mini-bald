# Copy to .env — docker compose reads it automatically.
PORT=8080
TZ=Europe/Rome
# Host folder that holds ALL app data (database + photos). Copy it as-is to migrate.
DATA_PATH=./data
# User/group the container runs as; must be able to write DATA_PATH (run `id` to find yours).
PUID=1000
PGID=1000
# ---- AI assistant (optional) ----
# The key stays in the backend and is never sent to the browser. Leave it empty to switch the assistant off.
ANTHROPIC_API_KEY=
# Model used for recipes, feedback and tutorial searches. Cheaper alternatives:
# claude-sonnet-5-5, claude-haiku-5-5.
AI_MODEL=claude-opus-5-5
# Optional thinking effort: low, medium, high, xhigh, max. Empty = the model's default.
AI_EFFORT=
# Language of the assistant's answers (the interface itself stays in English).
AI_LANGUAGE=English
